diff --git a/src/dialogue_cjk.c b/src/dialogue_cjk.c
new file mode 100644
index 0000000..0497900
--- /dev/null
+++ b/src/dialogue_cjk.c
@@ -0,0 +1,85 @@
+#include "dialogue_cjk.h"
+
+// The messaging buffer keeps its pixels in 16-bit words: one word holds eight
+// bitplanes of one column, so a pixel column is written as a mask into the
+// byte at that column's half. These are the masks a text row uses, the same
+// ones the letter renderer in messaging.c uses.
+static const uint8_t kColumnMasks[8] = {0x80, 0x40, 0x20, 0x10, 8, 4, 2, 1};
+
+bool DialogueCjk_DecodePage(uint8_t prefix, uint8_t index, uint32_t *out_char) {
+  if (prefix < kDialogueCjkPageFirst || prefix > kDialogueCjkPageLast)
+    return false;
+  *out_char = (uint32_t)(kDialogueCjkFirstChar +
+                         (prefix - kDialogueCjkPageFirst) * 256 + index);
+  return true;
+}
+
+bool DialogueCjk_IsGlyph(int c) {
+  return c >= kDialogueCjkFirstChar;
+}
+
+// Draws one 8x16 half tile at the current pen position and advances the pen.
+// `top` and `bottom` are the half tile's upper and lower eight rows, one bit
+// per pixel, most significant bit leftmost. The pen keeps two values: the
+// leftmost free column of this line (in `arr`) and the next free slot.
+static void RenderHalf(const DialogueCjkTarget *target, const uint8_t *top,
+                       const uint8_t *bottom, int width) {
+  if (width <= 0)
+    return;
+  int slot = (*target->pen)++;
+  uint8_t pen_x = target->arr[slot];
+  target->arr[slot + 1] = (uint8_t)(pen_x + width);
+
+  uint16_t base = (uint16_t)(pen_x * 2);
+  uint8_t *buf = target->buf;
+
+  for (int pass = 0; pass < 2; pass++) {
+    // The second pass draws the tile's lower half eight rows further down the
+    // buffer, which is where the message box keeps it.
+    int line = pass == 0 ? target->line : target->line + 0x150;
+    const uint8_t *src = pass == 0 ? top : bottom;
+    for (int row = 0; row < 16; row += 2) {
+      uint16_t bits = (uint16_t)(src[0] | (src[1] << 8));
+      src += 2;
+      int y = base + line;
+      int x = (y & 0xff0) + row;
+      y = (y >> 1) & 7;
+      int left = width;
+      do {
+        // Each iteration consumes one bit of the row and moves to the next
+        // pixel row, which is the next bitplane of the same column.
+        uint8_t mask = kColumnMasks[y];
+        if (bits & 0x0080)
+          buf[x + 0] ^= mask;
+        else
+          buf[x + 0] &= (uint8_t)~mask;
+        if (bits & 0x8000)
+          buf[x + 1] ^= mask;
+        else
+          buf[x + 1] &= (uint8_t)~mask;
+        bits = (uint16_t)((bits & ~0x8080) << 1);
+      } while (--left && ++y != 8);
+      x += 16;
+      // Whatever did not fit the row's bitplanes continues in the next word,
+      // exactly as the letter renderer stores it.
+      if (bits != 0) {
+        buf[x + 0] = (uint8_t)(bits & 0xff);
+        buf[x + 1] = (uint8_t)(bits >> 8);
+      }
+    }
+  }
+}
+
+void DialogueCjk_Render(const DialogueCjkTarget *target, int glyph) {
+  const uint8_t *base = target->glyphs + glyph * kDialogueCjkGlyphBytes;
+  int total = target->widths[kDialogueCjkFirstChar + glyph];
+
+  // A glyph is drawn as two half tiles side by side: the left one holds the
+  // glyph's left eight columns, the right one the rest. Wide glyphs simply
+  // advance the pen twice as far.
+  RenderHalf(target, base + 0 * kDialogueCjkHalfBytes,
+             base + 2 * kDialogueCjkHalfBytes, total > 8 ? 8 : total);
+  if (total > 8)
+    RenderHalf(target, base + 1 * kDialogueCjkHalfBytes,
+               base + 3 * kDialogueCjkHalfBytes, total - 8);
+}
diff --git a/src/dialogue_cjk.h b/src/dialogue_cjk.h
new file mode 100644
index 0000000..efe1a9e
--- /dev/null
+++ b/src/dialogue_cjk.h
@@ -0,0 +1,61 @@
+// Chinese (and, in principle, any 16x16 CJK) text for the dialogue engine.
+//
+// The languages the port builds from the USA cartridge reuse the cartridge's
+// own 8x16 letter alphabet: 256 tiles, one width byte per letter. A Chinese
+// translation cannot: it needs thousands of 16x16 glyphs and a way to name
+// them. Such a language carries two extra pieces in its asset language block,
+// both appended after the standard ones:
+//
+//    font block:  4096 bytes of 256 8x16 letter tiles, then
+//                 glyph_count * 64 bytes, one 16x16 1bpp glyph each
+//                 (top-left, top-right, bottom-left, bottom-right, 16B each)
+//    width block: 99 letter widths, then one total width byte per glyph
+//
+// Its messages then name a glyph with two bytes, a page byte and its index,
+// the shape the Japanese cartridge uses (see Text_DecodeCmd): page 0xf0 holds
+// glyphs 0..255 and 0xf4 holds 1024..1279, named 111 and up in the text
+// engine's alphabet. dialogue_flags bit 2 says the text is page-coded, which
+// both languages share; bit 3 says each glyph is 16x16 and its own width, the
+// shape only a Chinese pack has. The text engine renders such a glyph as two
+// 8x16 half tiles, which is the width of one letter column in the messaging
+// buffer.
+#ifndef ZELDA3_DIALOGUE_CJK_H_
+#define ZELDA3_DIALOGUE_CJK_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+enum {
+  kDialogueCjkFlag = 8,           // dialogue_flags bit 3: 16x16 glyphs, own widths
+  kDialogueCjkFirstChar = 111,    // first glyph index a page names
+  kDialogueCjkPageFirst = 0xf0,   // first page byte
+  kDialogueCjkPageLast = 0xf4,    // last one: 5 * 256 glyphs reachable
+  kDialogueCjkFontOffset = 4096,  // glyphs start behind the 256 letter tiles
+  kDialogueCjkGlyphBytes = 64,    // one 16x16 glyph
+  kDialogueCjkHalfBytes = 16,     // one 8x16 half tile
+};
+
+// Decodes one page pair into the character the text engine carries in its
+// command word. Returns false when `prefix` is not a page byte, in which case
+// the caller keeps its normal handling.
+bool DialogueCjk_DecodePage(uint8_t prefix, uint8_t index, uint32_t *out_char);
+
+// True when text character `c` names a glyph rather than a letter.
+bool DialogueCjk_IsGlyph(int c);
+
+// Where the renderer draws: the messaging buffer, the pen state the caller
+// owns, and the language's font block. `glyphs` points at the first 16x16
+// glyph; `widths` at the block's width bytes.
+typedef struct DialogueCjkTarget {
+  uint8_t *buf;           // messaging buffer (16-bit words seen as bytes)
+  uint8_t *arr;           // per-column pen positions
+  uint16_t *pen;          // next free column slot
+  int line;               // first row of the message line
+  const uint8_t *glyphs;  // 16x16 glyphs
+  const uint8_t *widths;  // width bytes, indexed by kDialogueCjkFirstChar + n
+} DialogueCjkTarget;
+
+// Draws one glyph (0-based, as a page names it) at the current pen.
+void DialogueCjk_Render(const DialogueCjkTarget *target, int glyph);
+
+#endif  // ZELDA3_DIALOGUE_CJK_H_
